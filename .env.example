# Copy to .env and fill in. NEVER commit .env. Values here are placeholders, not real secrets.

# --- PostgreSQL / PostGIS ---
POSTGRES_DB=kommunfix
POSTGRES_USER=kommunfix
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- Garage (S3-compatible object storage) ---
# Generate: openssl rand -hex 32
GARAGE_RPC_SECRET=
# Generate: openssl rand -base64 32
GARAGE_ADMIN_TOKEN=
GARAGE_S3_PORT=3900
GARAGE_ADMIN_PORT=3903

# --- Backend S3 client (fill in after the bucket/key setup in infra/garage/README.md) ---
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=kommunfix-images
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- AI image analysis ---
# Provider not chosen yet (a free service, to be decided by the team).
# Backend only: never expose these to the frontend.
AI_PROVIDER=
AI_API_URL=
AI_API_KEY=
